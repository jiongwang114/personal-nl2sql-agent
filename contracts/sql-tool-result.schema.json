{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dataengineer.local/contracts/sql-tool-result.schema.json",
  "title": "SQL Tool Results",
  "$defs": {
    "diagnostic": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "severity": { "enum": ["info", "warning", "error"] }
      },
      "additionalProperties": false
    },
    "guardResult": {
      "type": "object",
      "required": ["allowed", "dialect", "statement_type", "formatted_sql", "tables", "diagnostics"],
      "properties": {
        "allowed": { "type": "boolean" },
        "dialect": { "type": "string" },
        "statement_type": { "type": "string" },
        "formatted_sql": { "type": "string" },
        "tables": { "type": "array", "items": { "type": "string" } },
        "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } }
      },
      "additionalProperties": false
    },
    "executionResult": {
      "type": "object",
      "required": ["success", "datasource", "dialect", "columns", "rows", "row_count", "truncated", "elapsed_ms"],
      "properties": {
        "success": { "type": "boolean" },
        "datasource": { "type": "string" },
        "dialect": { "type": "string" },
        "columns": { "type": "array", "items": { "type": "string" } },
        "rows": { "type": "array", "items": {} },
        "row_count": { "type": "integer", "minimum": 0 },
        "truncated": { "type": "boolean" },
        "elapsed_ms": { "type": "number", "minimum": 0 },
        "error": { "$ref": "#/$defs/diagnostic" }
      },
      "additionalProperties": false
    }
  }
}
