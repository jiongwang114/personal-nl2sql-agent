# Copy this file to .env and fill in a real key locally.
# Never commit .env or a real API key.
OPENAI_API_KEY=
WLB_API_KEY=
# Optional second WLB key for the isolated dual-service benchmark runner.
# Keep this separate from WLB_API_KEY; do not commit a real key.
WLB_API_KEY_2=

# Optional alternative providers
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# Frontend development only. Leave blank when FastAPI serves the built frontend.
# Do not put API keys or access tokens in VITE_* variables: they are public in the browser bundle.
VITE_API_BASE_URL=
# Optional anonymous user scope. Allowed characters: letters, digits, underscore and hyphen.
VITE_USER_ID=
